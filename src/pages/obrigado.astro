---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import Squiggle from '../components/Squiggle.astro';
import { METODO } from '../data/content';
---
<Base
  title="Recebemos sua mensagem"
  description="Sua solicitação de conversa de Discovery foi recebida pela IMAKERS."
  path="/obrigado"
  noindex
>
  <section class="section ob">
    <div class="wrap-narrow ob__inner">
      <Squiggle class="ob__sq" animate color="var(--magenta)" />
      <p class="eyebrow">Mensagem recebida</p>
      <h1>Recebemos sua mensagem.</h1>
      <p class="lede lede--wide">
        Agora vamos olhar para o contexto que você compartilhou e retornar com os próximos passos para a
        conversa de Discovery.
      </p>
      <p class="muted">Enquanto isso, conheça como a IMAKERS transforma presença em operação.</p>

      <div class="grid grid-3 ob__cards">
        {METODO.map((m) => (
          <a href={m.href} class="card card--link">
            <span class="card__num">{m.etapa}</span>
            <h2>{m.nome}</h2>
            <p>{m.frase}</p>
          </a>
        ))}
      </div>

      <div class="btn-row ob__row">
        <a href="/blog" class="btn">Ler o blog<Arrow /></a>
        <a href="/" class="btn btn--ghost">Voltar para o início</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .ob { padding-block: clamp(4rem, 2.5rem + 7vw, 8rem); }
  .ob__inner { display: grid; gap: var(--sp-4); text-align: center; justify-items: center; }
  .ob__sq { width: min(18rem, 60%); margin-bottom: var(--sp-3); }
  .ob h1 { font-size: var(--step-4); }
  .ob .lede { margin-inline: auto; }
  .ob__cards { margin-top: var(--sp-7); width: 100%; text-align: left; }
  .ob__cards h2 { font-size: var(--step-1); }
  .ob__cards a { text-decoration: none; }
  .ob__row { margin-top: var(--sp-6); justify-content: center; }
</style>
