---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import Squiggle from '../components/Squiggle.astro';
import CtaBand from '../components/CtaBand.astro';
import { PERGUNTAS, RESULTADOS } from '../data/quiz';
import { faqSchema } from '../data/schema';

const crumbs = [{ name: 'Autoleitura', href: '/autoleitura' }];
const faq = [
  {
    q: 'A autoleitura substitui o Discovery?',
    a: 'Não. Ela dá uma direção inicial em dois minutos. O Discovery é a etapa em que essa direção vira escopo, arquitetura, prioridade e plano de ativação.',
  },
  {
    q: 'Meus dados ficam salvos?',
    a: 'Não. A autoleitura roda inteiramente no seu navegador: nenhuma resposta é enviada para a IMAKERS. Se você quiser continuar a conversa, o resultado pode ser levado para o formulário de contato — e só nesse momento algo é enviado.',
  },
  {
    q: 'E se o resultado não parecer o meu caso?',
    a: 'Provavelmente sua operação está entre duas faixas — o que é comum. Leve o resultado para a conversa: entender por que ele não encaixa costuma ser a informação mais útil do Discovery.',
  },
];
---
<Base
  title="Autoleitura IMAKERS — qual estrutura sua presença está pedindo?"
  description="Seis perguntas, dois minutos e uma recomendação de faixa: Base, Capture, Commerce ou Recurring. Roda no seu navegador, sem cadastro e sem enviar nada."
  path="/autoleitura"
  image="/og/autoleitura.png"
  breadcrumbs={crumbs}
  schema={[faqSchema(faq)]}
>
  <section class="q-hero">
    <div class="q-hero__glow" aria-hidden="true"></div>
    <div class="wrap q-hero__inner">
      <nav class="crumbs" aria-label="Você está aqui">
        <ol role="list"><li><a href="/">Início</a></li><li><a href="/autoleitura">Autoleitura</a></li></ol>
      </nav>
      <p class="eyebrow">Autoleitura</p>
      <h1>Qual estrutura a sua presença está pedindo?</h1>
      <p class="lede lede--wide">
        Seis perguntas, dois minutos e uma recomendação clara de por onde começar. Roda no seu navegador:
        nada é enviado, nada é salvo, nenhum cadastro é pedido.
      </p>
    </div>
  </section>

  <section class="section section--tight" aria-label="Questionário de autoleitura">
    <div class="wrap-narrow">
      <div class="quiz" data-quiz>
        <!-- Barra de progresso -->
        <div class="quiz__bar" data-quiz-bar>
          <div class="quiz__progress">
            <span class="quiz__progress-fill" data-quiz-fill style="width:0%"></span>
          </div>
          <p class="quiz__count">
            Pergunta <strong data-quiz-current>1</strong> de {PERGUNTAS.length}
          </p>
        </div>

        <!-- Perguntas -->
        <form class="quiz__form" data-quiz-form>
          {PERGUNTAS.map((p, i) => (
            <fieldset class="quiz__step" data-step={i} hidden={i !== 0}>
              <legend class="quiz__legend">
                <span class="quiz__legend-n">{String(i + 1).padStart(2, '0')}</span>
                <span class="quiz__legend-t">{p.titulo}</span>
              </legend>
              {p.ajuda && <p class="quiz__help">{p.ajuda}</p>}
              <div class="quiz__opts">
                {p.opcoes.map((o, j) => (
                  <label class="quiz__opt">
                    <input type="radio" name={p.id} value={j} data-pontos={JSON.stringify(o.pontos)} />
                    <span class="quiz__opt-box">
                      <span class="quiz__opt-mark" aria-hidden="true"></span>
                      <span class="quiz__opt-label">{o.label}</span>
                    </span>
                  </label>
                ))}
              </div>
              <div class="quiz__nav">
                {i > 0 && <button type="button" class="btn btn--ghost" data-quiz-prev>Voltar</button>}
                <span class="quiz__nav-hint" data-quiz-hint>Escolha uma opção para continuar</span>
              </div>
            </fieldset>
          ))}
        </form>

        <!-- Resultado -->
        <div class="quiz__result" data-quiz-result hidden aria-live="polite">
          <p class="eyebrow">Sua autoleitura</p>
          <h2 data-result-nome></h2>
          <p class="quiz__frase" data-result-frase></p>
          <p class="quiz__diag" data-result-diag></p>

          <div class="quiz__scores" data-result-scores></div>

          <h3 class="quiz__sub">Os primeiros ativos a construir</h3>
          <ul role="list" class="checklist" data-result-primeiros></ul>

          <div class="btn-row quiz__actions">
            <a href="/contato" class="btn btn--lg" data-result-cta>
              Levar este resultado para a conversa<Arrow />
            </a>
            <a href="/solucoes" class="btn btn--lg btn--ghost" data-result-faixa>Ver a faixa em detalhe</a>
          </div>
          <button type="button" class="quiz__redo" data-quiz-redo>Refazer a autoleitura</button>
        </div>

        <noscript>
          <div class="quiz__noscript">
            <h2>A autoleitura precisa de JavaScript</h2>
            <p>
              Ela roda inteiramente no seu navegador — por isso depende de JavaScript ativo. Se preferir, o
              mesmo diagnóstico pode ser feito em conversa: descreva o que você já construiu e o que precisa
              acontecer depois que alguém encontra você.
            </p>
            <a href="/contato" class="btn">Falar com a IMAKERS</a>
            <h3>As perguntas, caso você queira pensar antes</h3>
            <ol>
              {PERGUNTAS.map((p) => (
                <li>
                  <strong>{p.titulo}</strong>
                  <ul>{p.opcoes.map((o) => <li>{o.label}</li>)}</ul>
                </li>
              ))}
            </ol>
          </div>
        </noscript>
      </div>

      <Squiggle class="quiz__deco" animate color="color-mix(in srgb, var(--magenta) 30%, transparent)" />
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="qfaq">
    <div class="wrap-narrow prose">
      <h2 id="qfaq">Sobre a autoleitura</h2>
      {faq.map((f) => (<div><h3>{f.q}</h3><p>{f.a}</p></div>))}
    </div>
  </section>

  <CtaBand
    eyebrow="Depois da autoleitura"
    title="O Discovery transforma a direção em plano."
    text="A autoleitura aponta o caminho. O Discovery define o escopo, a arquitetura e a ordem de construção."
    primary={{ label: 'Solicitar conversa de Discovery', href: '/contato' }}
    secondary={{ label: 'Comparar as faixas', href: '/solucoes' }}
  />
</Base>

<script is:inline define:vars={{ RESULTADOS, TOTAL: PERGUNTAS.length }}>
  (() => {
    const root = document.querySelector('[data-quiz]');
    if (!root) return;
    const form = root.querySelector('[data-quiz-form]');
    const steps = [...root.querySelectorAll('.quiz__step')];
    const fill = root.querySelector('[data-quiz-fill]');
    const current = root.querySelector('[data-quiz-current]');
    const bar = root.querySelector('[data-quiz-bar]');
    const result = root.querySelector('[data-quiz-result]');
    const FAIXAS = ['base', 'capture', 'commerce', 'recurring'];

    let idx = 0;
    const respostas = new Array(steps.length).fill(null);

    const setProgress = () => {
      const pct = Math.round((idx / TOTAL) * 100);
      fill.style.width = pct + '%';
      current.textContent = String(Math.min(idx + 1, TOTAL));
    };

    const show = (n) => {
      steps.forEach((s, i) => (s.hidden = i !== n));
      idx = n;
      setProgress();
      const legend = steps[n].querySelector('.quiz__legend-t');
      if (legend) legend.setAttribute('tabindex', '-1'), legend.focus({ preventScroll: true });
      const top = root.getBoundingClientRect().top + window.scrollY - 110;
      window.scrollTo({ top, behavior: 'smooth' });
    };

    const somar = () => {
      const total = { base: 0, capture: 0, commerce: 0, recurring: 0 };
      respostas.forEach((p) => {
        if (!p) return;
        for (const k of FAIXAS) total[k] += p[k] || 0;
      });
      return total;
    };

    const finalizar = () => {
      const total = somar();
      const max = Math.max(...FAIXAS.map((f) => total[f]));
      // Empate: vence a faixa mais simples — nunca recomendamos mais estrutura
      // do que o negócio demonstrou precisar.
      const vencedora = FAIXAS.find((f) => total[f] === max);
      const r = RESULTADOS[vencedora];

      result.querySelector('[data-result-nome]').textContent = r.nome;
      result.querySelector('[data-result-frase]').textContent = r.frase;
      result.querySelector('[data-result-diag]').textContent = r.diagnostico;
      result.querySelector('[data-result-primeiros]').innerHTML = r.primeiros
        .map((p) => '<li>' + p + '</li>')
        .join('');
      result.querySelector('[data-result-faixa]').href = r.href;
      result.querySelector('[data-result-cta]').href =
        '/contato?faixa=' + vencedora + '&origem=autoleitura';

      const somaTotal = FAIXAS.reduce((a, f) => a + total[f], 0) || 1;
      result.querySelector('[data-result-scores]').innerHTML = FAIXAS.map((f) => {
        const pct = Math.round((total[f] / somaTotal) * 100);
        return (
          '<div class="quiz__score' + (f === vencedora ? ' is-top' : '') + '">' +
          '<span class="quiz__score-name">' + RESULTADOS[f].nome.replace('IMAKERS ', '') + '</span>' +
          '<span class="quiz__score-track"><span class="quiz__score-fill" style="width:' + pct + '%"></span></span>' +
          '<span class="quiz__score-pct">' + pct + '%</span></div>'
        );
      }).join('');

      form.hidden = true;
      bar.hidden = true;
      result.hidden = false;
      fill.style.width = '100%';
      window.scrollTo({ top: root.getBoundingClientRect().top + window.scrollY - 110, behavior: 'smooth' });
    };

    form.addEventListener('change', (e) => {
      const input = e.target;
      if (input.type !== 'radio') return;
      respostas[idx] = JSON.parse(input.dataset.pontos);
      setTimeout(() => (idx < steps.length - 1 ? show(idx + 1) : finalizar()), 220);
    });

    root.addEventListener('click', (e) => {
      if (e.target.closest('[data-quiz-prev]')) show(idx - 1);
      if (e.target.closest('[data-quiz-redo]')) {
        form.reset();
        respostas.fill(null);
        form.hidden = false;
        bar.hidden = false;
        result.hidden = true;
        show(0);
      }
    });

    setProgress();
  })();
</script>

<style>
  .q-hero { position: relative; padding-block: clamp(3rem, 2rem + 5vw, 5.5rem) var(--sp-6); overflow: hidden; }
  .q-hero__glow {
    position: absolute; top: -50%; left: 50%; translate: -50% 0;
    inline-size: min(60rem, 130%); aspect-ratio: 2/1;
    background: radial-gradient(ellipse at center, color-mix(in srgb, var(--magenta) 14%, transparent) 0%, transparent 68%);
  }
  .q-hero__inner { position: relative; max-width: 46rem; display: grid; gap: var(--sp-4); }
  .q-hero h1 { font-size: var(--step-4); }
  .crumbs ol { display: flex; gap: 0.5rem; list-style: none; padding: 0; font-size: var(--step--2); color: var(--fg-subtle); }
  .crumbs li + li::before { content: '/'; margin-right: 0.5rem; opacity: 0.5; }
  .crumbs a { color: inherit; text-decoration: none; }

  .quiz {
    position: relative;
    padding: clamp(1.5rem, 1rem + 3vw, 3rem);
    background: var(--surface); border: 1px solid var(--line);
    border-radius: var(--r-xl); box-shadow: var(--shadow-lg);
  }
  .quiz__bar { display: grid; gap: var(--sp-3); margin-bottom: var(--sp-6); }
  .quiz__progress { block-size: 4px; background: var(--bg-2); border-radius: var(--r-full); overflow: hidden; }
  .quiz__progress-fill { display: block; block-size: 100%; background: var(--accent); border-radius: inherit; transition: width 0.45s var(--ease); }
  .quiz__count { font-size: var(--step--2); color: var(--fg-subtle); font-family: var(--font-display); letter-spacing: 0.06em; }
  .quiz__count strong { color: var(--accent); }

  .quiz__step { border: 0; padding: 0; margin: 0; display: grid; gap: var(--sp-4); }
  .quiz__legend { display: grid; gap: var(--sp-2); padding: 0; float: left; width: 100%; }
  .quiz__legend-n { font-family: var(--font-mono); font-size: var(--step--2); font-weight: 600; letter-spacing: 0.12em; color: var(--accent); }
  .quiz__legend-t {
    display: block; font-family: var(--font-display); font-size: var(--step-2); font-weight: 700;
    letter-spacing: -0.025em; line-height: 1.2; outline: none;
  }
  .quiz__help { clear: both; font-size: var(--step--1); color: var(--fg-subtle); }

  .quiz__opts { display: grid; gap: 0.6rem; }
  .quiz__opt input { position: absolute; opacity: 0; pointer-events: none; }
  .quiz__opt-box {
    display: grid; grid-template-columns: auto 1fr; gap: 0.85rem; align-items: center;
    padding: 1rem 1.15rem; cursor: pointer;
    border: 1px solid var(--line); border-radius: var(--r-md);
    background: var(--bg); font-size: var(--step-0); line-height: 1.4;
    transition: border-color 0.2s, background-color 0.2s, transform 0.2s var(--ease);
  }
  .quiz__opt-box:hover { border-color: color-mix(in srgb, var(--accent) 50%, var(--line)); transform: translateX(3px); }
  .quiz__opt-mark {
    inline-size: 1.1rem; block-size: 1.1rem; border-radius: 50%;
    border: 2px solid var(--line-strong); transition: border-color 0.2s, box-shadow 0.2s;
  }
  .quiz__opt input:checked + .quiz__opt-box { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 6%, var(--bg)); }
  .quiz__opt input:checked + .quiz__opt-box .quiz__opt-mark { border-color: var(--accent); box-shadow: inset 0 0 0 3px var(--accent); }
  .quiz__opt input:focus-visible + .quiz__opt-box { box-shadow: var(--ring); }

  .quiz__nav { display: flex; flex-wrap: wrap; align-items: center; gap: var(--sp-4); margin-top: var(--sp-2); }
  .quiz__nav-hint { font-size: var(--step--2); color: var(--fg-subtle); }

  .quiz__result { display: grid; gap: var(--sp-4); }
  .quiz__result h2 { font-size: var(--step-3); }
  .quiz__frase { font-family: var(--font-display); font-size: var(--step-1); font-weight: 600; letter-spacing: -0.02em; color: var(--accent); line-height: 1.3; }
  .quiz__diag { color: var(--fg-muted); line-height: 1.65; }
  .quiz__sub { font-family: var(--font-display); font-size: var(--step--2); font-weight: 700; letter-spacing: 0.11em; text-transform: uppercase; color: var(--fg-subtle); margin-top: var(--sp-2); }
  .quiz__actions { margin-top: var(--sp-4); }
  .quiz__redo { justify-self: start; font-size: var(--step--2); color: var(--fg-subtle); text-decoration: underline; text-underline-offset: 0.2em; cursor: pointer; }

  .quiz__scores { display: grid; gap: 0.55rem; padding: var(--sp-5); background: var(--bg-2); border-radius: var(--r-md); margin-top: var(--sp-2); }
  /* Estas linhas são criadas por JavaScript e não recebem o atributo de escopo
     do Astro — por isso precisam de :global para serem estilizadas. */
  .quiz__scores :global(.quiz__score) {
    display: grid; grid-template-columns: 6.5rem minmax(0, 1fr) 2.8rem;
    gap: 0.75rem; align-items: center; font-size: var(--step--2);
  }
  .quiz__scores :global(.quiz__score-name) { font-family: var(--font-display); font-weight: 600; color: var(--fg-subtle); }
  .quiz__scores :global(.is-top .quiz__score-name) { color: var(--fg); }
  .quiz__scores :global(.quiz__score-track) { block-size: 7px; background: var(--line); border-radius: var(--r-full); overflow: hidden; }
  .quiz__scores :global(.quiz__score-fill) { display: block; block-size: 100%; background: var(--line-strong); border-radius: inherit; transition: width 0.6s var(--ease); }
  .quiz__scores :global(.is-top .quiz__score-fill) { background: var(--accent); }
  .quiz__scores :global(.quiz__score-pct) { text-align: right; font-family: var(--font-mono); color: var(--fg-subtle); }

  .quiz__noscript { display: grid; gap: var(--sp-4); }
  .quiz__noscript h2 { font-size: var(--step-2); }
  .quiz__noscript h3 { font-size: var(--step-1); margin-top: var(--sp-4); }
  .quiz__noscript ol { padding-left: 1.2em; display: grid; gap: var(--sp-4); }
  .quiz__noscript ul { padding-left: 1.2em; margin-top: 0.4em; color: var(--fg-muted); font-size: var(--step--1); }
  .quiz__noscript .btn { justify-self: start; }

  .quiz__deco { width: min(20rem, 60%); margin: var(--sp-7) auto 0; }
</style>
