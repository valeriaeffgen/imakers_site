---
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  /** Nivel do heading — mantem a hierarquia correta em cada pagina. */
  as?: 'h2' | 'h3';
  align?: 'start' | 'center';
  class?: string;
}
const { eyebrow, title, lede, as: Tag = 'h2', align = 'start', class: cls = '' } = Astro.props;
---
<div class={`section-head reveal ${align === 'center' ? 'section-head--center' : ''} ${cls}`}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Tag set:html={title} />
  {lede && <p class="lede lede--wide" set:html={lede} />}
  <slot />
</div>
<style>
  .section-head--center { margin-inline: auto; text-align: center; }
  .section-head--center .lede { margin-inline: auto; }
  .section-head--center .eyebrow::before { display: none; }
</style>
