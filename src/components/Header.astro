---
import Logo from './Logo.astro';
import { NAV, CTA } from '../config';

const here = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const isActive = (href: string) => here === href || (href !== '/' && here.startsWith(href + '/'));
---
<header class="hd" data-header>
  <div class="wrap hd__bar">
    <Logo size="1.45rem" />

    <nav class="hd__nav" aria-label="Navegação principal">
      <ul role="list" class="hd__list">
        {NAV.map((item) => (
          <li class={`hd__item ${item.children ? 'has-menu' : ''}`}>
            <a
              href={item.href}
              class="hd__link"
              aria-current={isActive(item.href) || item.children?.some((c) => isActive(c.href)) ? 'page' : undefined}
            >
              {item.label}
              {item.children && (
                <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
                  <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              )}
            </a>
            {item.children && (
              <div class="hd__menu">
                <ul role="list" aria-label={`Seções de ${item.label}`}>
                  {item.children.map((c) => (
                    <li>
                      <a href={c.href}>
                        <span class="hd__menu-label">{c.label}</span>
                        <span class="hd__menu-note">{c.note}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="hd__actions">
      <a href={CTA.header.href} class="btn btn--ink hd__cta">
        {CTA.header.label}
        <svg class="btn__arrow" width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
          <path d="M1 5h11M8.5 1.5 12 5 8.5 8.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
      <button type="button" class="hd__burger" aria-expanded="false" aria-controls="menu-mobile" data-burger>
        <span class="visually-hidden">Abrir menu</span>
        <span class="hd__burger-bars" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>

  <div class="hd__drawer" id="menu-mobile" hidden data-drawer>
    <nav class="wrap" aria-label="Navegação móvel">
      <ul role="list" class="hd__drawer-list">
        {NAV.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
            {item.children && (
              <ul role="list" class="hd__drawer-sub">
                {item.children.map((c) => (
                  <li><a href={c.href}>{c.label}</a></li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
      <a href={CTA.header.href} class="btn btn--lg hd__drawer-cta">{CTA.header.label}</a>
    </nav>
  </div>
</header>

<style>
  .hd {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(180%) blur(14px);
    -webkit-backdrop-filter: saturate(180%) blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s var(--ease), background-color 0.3s var(--ease);
  }
  .hd[data-scrolled] { border-bottom-color: var(--line); background: color-mix(in srgb, var(--bg) 92%, transparent); }
  .hd__bar { display: flex; align-items: center; gap: var(--sp-5); min-height: 4.5rem; }

  .hd__nav { display: none; margin-inline: auto; }
  @media (min-width: 62em) { .hd__nav { display: block; } }
  .hd__list { display: flex; align-items: center; gap: 0.35rem; list-style: none; padding: 0; }
  .hd__item { position: relative; }
  .hd__link {
    display: inline-flex; align-items: center; gap: 0.35em;
    padding: 0.55rem 0.8rem; border-radius: var(--r-full);
    font-family: var(--font-display); font-size: var(--step--1); font-weight: 550;
    color: var(--fg-muted); text-decoration: none; white-space: nowrap;
    transition: color 0.2s, background-color 0.2s;
  }
  .hd__link:hover, .hd__item:focus-within .hd__link { color: var(--fg); background: var(--bg-2); }
  .hd__link[aria-current='page'] { color: var(--fg); }
  .hd__link svg { transition: transform 0.25s var(--ease); opacity: 0.6; }
  .hd__item:hover .hd__link svg, .hd__item:focus-within .hd__link svg { transform: rotate(180deg); }

  .hd__menu {
    position: absolute; top: calc(100% + 0.4rem); left: 50%;
    width: 22rem; padding: 0.5rem;
    background: var(--surface); border: 1px solid var(--line);
    border-radius: var(--r-lg); box-shadow: var(--shadow-lg);
    opacity: 0; visibility: hidden;
    transform: translate(-50%, -6px);
    transition: opacity 0.22s var(--ease), transform 0.22s var(--ease), visibility 0.22s;
  }
  .hd__item:hover .hd__menu, .hd__item:focus-within .hd__menu {
    opacity: 1; visibility: visible; transform: translate(-50%, 0);
  }
  .hd__menu ul { list-style: none; padding: 0; display: grid; gap: 2px; }
  .hd__menu a {
    display: grid; gap: 0.15rem; padding: 0.7rem 0.85rem;
    border-radius: var(--r-md); text-decoration: none;
    transition: background-color 0.18s;
  }
  .hd__menu a:hover { background: var(--bg-2); }
  .hd__menu-label { font-family: var(--font-display); font-weight: 650; font-size: var(--step--1); color: var(--fg); }
  .hd__menu-note { font-size: var(--step--2); color: var(--fg-subtle); line-height: 1.4; }

  .hd__actions { display: flex; align-items: center; gap: var(--sp-3); margin-left: auto; }
  @media (min-width: 62em) { .hd__actions { margin-left: 0; } }
  .hd__cta { display: none; }
  @media (min-width: 48em) { .hd__cta { display: inline-flex; } }

  .hd__burger {
    display: grid; place-items: center; inline-size: 2.75rem; block-size: 2.75rem;
    border: 1px solid var(--line-strong); border-radius: var(--r-full); cursor: pointer;
  }
  @media (min-width: 62em) { .hd__burger { display: none; } }
  .hd__burger-bars { display: grid; gap: 5px; }
  .hd__burger-bars i { display: block; inline-size: 17px; block-size: 2px; border-radius: 2px; background: var(--fg); transition: transform 0.3s var(--ease), opacity 0.2s; }
  .hd__burger[aria-expanded='true'] i:first-child { transform: translateY(3.5px) rotate(45deg); }
  .hd__burger[aria-expanded='true'] i:last-child { transform: translateY(-3.5px) rotate(-45deg); }

  .hd__drawer { border-top: 1px solid var(--line); background: var(--bg); padding-block: var(--sp-5) var(--sp-6); max-height: calc(100dvh - 4.5rem); overflow-y: auto; }
  @media (min-width: 62em) { .hd__drawer { display: none !important; } }
  .hd__drawer-list { list-style: none; padding: 0; display: grid; gap: var(--sp-4); }
  .hd__drawer-list > li > a { font-family: var(--font-display); font-size: var(--step-1); font-weight: 650; text-decoration: none; }
  .hd__drawer-sub { list-style: none; padding: 0.6rem 0 0 0.9rem; display: grid; gap: 0.45rem; border-left: 2px solid var(--line); margin-top: 0.5rem; }
  .hd__drawer-sub a { color: var(--fg-muted); font-size: var(--step--1); text-decoration: none; }
  .hd__drawer-cta { margin-top: var(--sp-6); width: 100%; }
</style>

<script is:inline>
  (() => {
    const header = document.querySelector('[data-header]');
    const burger = document.querySelector('[data-burger]');
    const drawer = document.querySelector('[data-drawer]');

    const onScroll = () => {
      if (window.scrollY > 8) header?.setAttribute('data-scrolled', '');
      else header?.removeAttribute('data-scrolled');
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    burger?.addEventListener('click', () => {
      const open = burger.getAttribute('aria-expanded') === 'true';
      burger.setAttribute('aria-expanded', String(!open));
      burger.querySelector('.visually-hidden').textContent = open ? 'Abrir menu' : 'Fechar menu';
      if (drawer) drawer.hidden = open;
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && burger?.getAttribute('aria-expanded') === 'true') burger.click();
    });
  })();
</script>
