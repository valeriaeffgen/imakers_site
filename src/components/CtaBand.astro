---
import Arrow from './Arrow.astro';
import Squiggle from './Squiggle.astro';
import { CTA } from '../config';

interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  micro?: string;
  primary?: { label: string; href: string };
  secondary?: { label: string; href: string } | null;
}
const {
  eyebrow = 'A próxima etapa da sua presença',
  title = 'Seu conteúdo já abriu a conversa. Vamos construir o negócio que vem depois?',
  text = 'Conte para a VOCIRE o que você já construiu, o que oferece e onde a sua operação trava hoje. Vamos identificar o próximo passo mais claro para transformar atenção em uma estrutura própria.',
  micro = 'Você não precisa chegar com tudo pronto. Basta ter uma presença, uma oferta ou uma oportunidade que merece ser desenvolvida.',
  primary = { label: 'Quero começar meu VOCIRE Discovery', href: '/contato' },
  secondary = CTA.quiz,
} = Astro.props;
---
<section class="band section--plum" data-theme="dark" aria-labelledby="band-title">
  <div class="wrap band__inner reveal">
    <Squiggle class="band__deco" animate color="var(--accent)" />
    <p class="eyebrow">{eyebrow}</p>
    <h2 id="band-title">{title}</h2>
    <p class="lede lede--wide">{text}</p>
    <div class="btn-row band__row">
      <a href={primary.href} class="btn btn--lg">{primary.label}<Arrow /></a>
      {secondary && <a href={secondary.href} class="btn btn--lg btn--ghost">{secondary.label}</a>}
    </div>
    {micro && <p class="subtle band__micro">{micro}</p>}
  </div>
</section>

<style>
  /* Menos ar embaixo: a faixa e o rodape sao ambos escuros e se fundem, entao
     o espaco que sobrava entre os dois lia como vazio, nao como respiro. */
  .band {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4rem, 2.5rem + 7vw, 8rem) clamp(3rem, 2rem + 4vw, 5.5rem);
  }
  /* Assinatura, nao papel de parede: a seta entra em tamanho humano antes do
     eyebrow. Sempre inteira, nunca cortada pela borda e nunca por cima do
     texto — em qualquer largura de tela. */
  .band__deco {
    width: 8.5rem;
    margin-bottom: calc(var(--sp-2) * -1);
  }
  .band__inner { position: relative; max-width: 52rem; display: grid; gap: var(--sp-5); }
  .band__inner h2 { font-size: var(--step-4); }
  .band__row { margin-top: var(--sp-2); }
  .band__micro { max-width: 46ch; }
</style>
